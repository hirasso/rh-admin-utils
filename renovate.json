{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only dependencies that ship in the release zip. Dev tooling is updated by hand.",
  "extends": ["config:recommended"],
  "enabledManagers": ["composer", "npm"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "ignorePaths": ["vendor-prefixed/**"],
  "gitIgnoredAuthors": ["bot@rassohilber.com"],
  "packageRules": [
    {
      "description": "Disable all Composer packages except the prefixed ones",
      "matchManagers": ["composer"],
      "matchPackageNames": ["!symfony/var-dumper"],
      "enabled": false
    },
    {
      "description": "The Renovate Sync workflow runs `composer prefix` on the branch",
      "matchManagers": ["composer"],
      "matchPackageNames": ["symfony/var-dumper"],
      "groupName": "prefixed dependencies"
    },
    {
      "description": "Disable npm, except the runtime dependencies bundled into assets/",
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "description": "The Renovate Sync workflow runs `pnpm build` on the branch",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "enabled": true,
      "groupName": "bundled dependencies"
    }
  ],
  "dependencyDashboard": false
}
