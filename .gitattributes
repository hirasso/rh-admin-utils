# hidden files and folders
.* export-ignore

# Tooling
assets-src export-ignore
package.json export-ignore
pnpm-lock.yaml export-ignore
postcss.config.cjs export-ignore
bin export-ignore
*.sh export-ignore
config/ export-ignore
pint.json export-ignore
pnpm-workspace.yaml export-ignore
tools export-ignore

# composer
composer.lock export-ignore

# Prefixed dependencies: shipped in both channels, but collapsed in diffs
vendor-prefixed/** linguist-vendored
vendor-prefixed/** -diff

*.md export-ignore

# Testing and static analysis
tests export-ignore
phpunit.xml.dist export-ignore
phpstan.neon export-ignore
