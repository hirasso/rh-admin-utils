{
  "name": "rh-admin-utils",
  "version": "4.1.4",
  "private": true,
  "type": "module",
  "author": "Rasso Hilber",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "prepare": "husky",
    "make-pot": "tools/make-pot.sh",
    "release:create": "tools/cli/create-release.js",
    "verify:prefixed": "tools/cli/verify-prefixed.js",
    "php-version:check": "tools/cli/php-version-check.js",
    "plugin-version:patch": "tools/cli/plugin-version-patch.js",
    "bundle": "node tools/build.mjs \"assets-src/*.{js,ts}\" -o assets",
    "watch": "pnpm run bundle",
    "build": "pnpm run bundle --production",
    "format:assets": "pnpm exec prettier --write ./assets-src/ ./tools/cli/",
    "format:php": "./vendor/bin/pint",
    "format": "pnpm run format:assets && pnpm run format:php",
    "version": "pnpm changeset version && pnpm run plugin-version:patch && pnpm run make-pot",
    "env": "wp-env",
    "env:test": "wp-env --config .wp-env.test.json",
    "launch": "open $(wp-env status --json | jq -r .urls.development)",
    "launch:test": "open $(wp-env --config .wp-env.test.json status --json | jq -r .urls.development)",
    "wp": "wp-env run cli wp",
    "composer": "wp-env run cli --env-cwd=wp-content/plugins/rh-admin-utils composer",
    "test": "pnpm test:pest && pnpm env:test reset && pnpm env:test start && pnpm test:e2e",
    "test:pest": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/rh-admin-utils composer test",
    "test:e2e": "pnpm exec playwright test --config ./tests/e2e/playwright.config.ts",
    "test:e2e:ui": "PLAYWRIGHT_ENV=dev pnpm test:e2e --ui",
    "test:e2e:install": "pnpm exec playwright install --with-deps"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.64.1",
    "@types/jquery": "^3.5.33",
    "@types/node": "^25.5.0",
    "@wordpress/env": "^11.16.0",
    "browserslist": "^4.29.4",
    "esbuild": "^0.28.2",
    "esbuild-plugin-browserslist": "^4.0.0",
    "fast-glob": "^3.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.4.40",
    "postcss-preset-env": "^9.6.0",
    "prettier": "3.3.3",
    "sass": "^1.77.8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@alpinejs/mask": "^3.14.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/state": "^6.4.1",
    "alpinejs": "^3.14.1",
    "codemirror": "^6.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
