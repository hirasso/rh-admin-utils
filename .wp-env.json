{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "phpVersion": "8.4",
  "core": "./vendor/__wp/core",
  "themes": ["./vendor/__wp/themes/twentytwentyfive"],
  "plugins": [".", "./tests/E2E"],
  "mappings": {
    "wp-content/plugins": "./vendor/__wp/plugins"
  },
  "env": {
    "development": {
      "port": 7428,
      "config": {
        "RHAU_WP_ENV": "development"
      }
    },
    "tests": {
      "port": 7429,
      "config": {
        "WP_DEBUG": true,
        "RHAU_WP_ENV": "tests"
      }
    }
  },
  "lifecycleScripts": {
    "afterStart": "./tools/wp-env-after-start.sh"
  }
}
